# Copy this file to .env and fill in real values for your environment.
# .env is gitignored - never commit real secrets.

# Secret key used to sign JWT auth tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Required before deploying publicly - without it, the server falls back to
# an insecure, publicly-known default key.
JWT_SECRET_KEY=

# Google OAuth ("Sign in with Google"). Optional - if left blank, the
# /auth/google/login and /auth/google/callback routes return a 503 instead
# of crashing, and the rest of the app works fine without them.
# See README.md for how to create these in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini API ("/invite-gemini" chat bot). Optional - if left blank, the
# invite command returns a clear in-chat message instead of crashing.
# Get a free key at https://aistudio.google.com/ (Get API key).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
